# Copy this file to .env and fill in your own API keys.
# The .env file is git-ignored and must never be committed.

# Google Generative AI key — powers the voice counselor responses (api/counselor.ts)
GOOGLE_API_KEY=your_google_api_key_here

# Deepgram key — issues short-lived tokens for streaming speech-to-text (api/deepgram-token.ts)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Sarvam key — text-to-speech synthesis (api/sarvam-tts.ts)
SARVAM_API_KEY=your_sarvam_api_key_here
